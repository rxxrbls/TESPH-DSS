# Copy this file to .streamlit/secrets.toml and replace the placeholders locally.
# Never commit .streamlit/secrets.toml.

[auth]
username = "YOUR_LOCAL_AUTHORIZED_USERNAME"
password = "YOUR_LOCAL_AUTHORIZED_PASSWORD"
email = "owner@example.com"

# Optional: enables email delivery for profile email changes.
[email]
smtp_host = "smtp.example.com"
smtp_port = "587"
smtp_username = "smtp-user"
smtp_password = "smtp-password"
from_email = "no-reply@example.com"
app_base_url = "http://localhost:8501"
